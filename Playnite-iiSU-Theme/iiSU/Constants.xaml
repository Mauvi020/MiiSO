<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:pmrk="clr-namespace:Playnite.FullscreenApp.Markup;assembly=Playnite.FullscreenApp"
                    mc:Ignorable="d">

    <!-- ================================================================== -->
    <!--  iiSU Theme - Constants (Wii channel style design system)          -->
    <!-- ================================================================== -->

    <!-- Core palette -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>

    <!-- Accent: Wii electric blue -> violet -->
    <Color x:Key="GlyphColor">#FF6FA8FF</Color>
    <Color x:Key="GlyphLightColor">#FFC9A6FF</Color>
    <Color x:Key="SelectionLightColor">#FF37415C</Color>
    <Color x:Key="OverlayColor">#CC0A0E17</Color>

    <!-- Surfaces -->
    <Color x:Key="ControlBackgroundColor">#FF1E2739</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF111827</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#FFEAF0FF</Color>
    <Color x:Key="TextColorDark">#FF8A93B0</Color>

    <!-- Accent palette (exposed for custom use) -->
    <Color x:Key="AccentBlueColor">#FF4F8CFF</Color>
    <Color x:Key="AccentVioletColor">#FF9B6DFF</Color>
    <Color x:Key="AccentPinkColor">#FFF472B6</Color>
    <Color x:Key="PanelColor">#F2151B2C</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{DynamicResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{DynamicResource AccentVioletColor}" />
    <SolidColorBrush x:Key="AccentPinkBrush" Color="{DynamicResource AccentPinkColor}" />

    <!-- Main background: deep navy radial glow (iiSU night sky) -->
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.05" Center="0.5,0.2" RadiusX="0.6" RadiusY="0.8">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF14234A" Offset="0" />
            <GradientStop Color="#FF0E1A33" Offset="0.55" />
            <GradientStop Color="#FF0A0E17" Offset="1.0" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- Top bar: translucent navy with subtle violet tint -->
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#E60E1A33" Offset="0" />
        <GradientStop Color="#C80A0E17" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Bottom bar -->
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#E60E1A33" Offset="0" />
        <GradientStop Color="#C80A0E17" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Overlay / menu panels (main menu, game menu, filters...) -->
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#FF15203A" Offset="0" />
        <GradientStop Color="#FF0A0E17" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Selection / focus glow: blue -> violet -->
    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0.5,-0.5" EndPoint="1,1.5">
        <GradientStop Color="{DynamicResource AccentBlueColor}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentVioletColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Panel behind the game details description -->
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#E60A0E17" Offset="0.8" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF6B6B" />

    <!-- Progress indicator accent (used by Media.xaml) -->
    <SolidColorBrush x:Key="ProgressGlyphBrush" Color="{DynamicResource AccentVioletColor}" />

    <!-- ================================================================ -->
    <!--  Fonts (bundled with the theme in /Fonts)                        -->
    <!-- ================================================================ -->
    <!--
        The game UI uses the iiSU font family. If a font file is missing the
        lookup degrades gracefully to Playnite's default Titillium Web font.
    -->
    <FontFamily x:Key="FontTitilliumWeb">{pmrk:ThemeFile 'Fonts/console_sans_regular.otf#Console Sans'}</FontFamily>
    <FontFamily x:Key="FontTitilliumWebLight">{pmrk:ThemeFile 'Fonts/console_sans_regular.otf#Console Sans'}</FontFamily>
    <FontFamily x:Key="FontTitilliumWebBold">{pmrk:ThemeFile 'Fonts/console_sans_extrabold.otf#Console Sans Extrabold'}</FontFamily>
    <FontFamily x:Key="FontConsoleSans">{pmrk:ThemeFile 'Fonts/console_sans_regular.otf#Console Sans'}</FontFamily>
    <FontFamily x:Key="FontConsoleBold">{pmrk:ThemeFile 'Fonts/console_sans_bold.otf#Console Sans Bold'}</FontFamily>
    <FontFamily x:Key="FontConsoleExtraBold">{pmrk:ThemeFile 'Fonts/console_sans_extrabold.otf#Console Sans Extrabold'}</FontFamily>
    <FontFamily x:Key="FontIisu">{pmrk:ThemeFile 'Fonts/iisu_arctainium.ttf#Arctainium'}</FontFamily>
    <FontFamily x:Key="FontGameNum">{pmrk:ThemeFile 'Fonts/gamenum_regular.otf#Gamenum'}</FontFamily>
    <FontFamily x:Key="FontGameMaster">{pmrk:ThemeFile 'Fonts/gamemaster_regular.otf#Gamemaster'}</FontFamily>

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>
    <sys:Double x:Key="FontSizeLarge">30</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>

    <GridLength x:Key="ProgressWindowWidth">640</GridLength>

    <!-- ================================================================ -->
    <!--  Base styles                                                      -->
    <!-- ================================================================ -->
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="TextBlockTitleStyle" BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontIisu}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
    </Style>
</ResourceDictionary>