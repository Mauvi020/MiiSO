<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bottom bar action buttons (Install / Play / Details / Options / Search / Filter) -->
    <Style x:Key="ButtonBottomMenu" TargetType="ButtonEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource SelectionLightBrush}"
                            BorderThickness="1"
                            Padding="8,4,8,4"
                            Margin="12,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{TemplateBinding InputHint}"
                                            Height="30" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Focusable="False"/>
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontFamily="{DynamicResource FontConsoleSans}"
                                       VerticalAlignment="Center">
                                <ContentPresenter />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>