<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Fallback-Icon, wenn ein Spiel kein eigenes Icon hat -->
    <BitmapImage x:Key="DefaultGameIcon"
                 UriSource="pack://application:,,,/Assets/Images/no_rom_icon.png"
                 popt:Freeze="True" />

    <!-- Fallback-Cover, wenn kein Cover-Grafik gefunden wurde -->
    <BitmapImage x:Key="DefaultGameCover"
                 UriSource="pack://application:,,,/Assets/Images/cover_background.png"
                 popt:Freeze="True" />

    <!-- Leerer-Bibliothek-Hero -->
    <BitmapImage x:Key="HeroNoRom"
                 UriSource="pack://application:,,,/Assets/Images/no_rom_hero.png"
                 popt:Freeze="True" />

</ResourceDictionary>