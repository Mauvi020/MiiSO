<UserControl x:Class="MiiSO.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MiiSO.Models"
             xmlns:svc="clr-namespace:MiiSO.Services">

    <UserControl.Resources>
        <svc:GameCoverConverter x:Key="CoverConv" />
        <svc:GameIconConverter x:Key="IconConv" />

        <Style x:Key="GameTileItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GameTileTemplate" DataType="{x:Type models:GameItem}">
            <Grid Width="300" Height="198" Margin="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="152" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="Glow" Grid.Row="0" CornerRadius="14" Margin="3,1,3,0" Opacity="0"
                        Background="{DynamicResource SelectionBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9" Color="{DynamicResource AccentBlueColor}" />
                    </Border.Effect>
                </Border>
                <Border x:Name="Card" Grid.Row="0" Margin="7,5,7,0" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource TileBackgroundBrush}"
                        BorderBrush="#33224F96" BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Image Source="{Binding CoverPath, Converter={StaticResource CoverConv}}"
                           Stretch="UniformToFill" />
                </Border>
                <Border Grid.Row="1" CornerRadius="0,0,10,10" Margin="7,0,7,0"
                        Background="{DynamicResource TileBandBrush}"
                        BorderBrush="#33224F96" BorderThickness="1,0,1,1">
                    <Grid>
                        <TextBlock Text="{Binding Name}" Margin="12,5,42,5"
                                   FontFamily="{DynamicResource FontConsoleSans}" FontSize="18"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Image Source="{Binding IconPath, Converter={StaticResource IconConv}}"
                               Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,10,0"
                               VerticalAlignment="Center" Stretch="Uniform" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.05" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.05" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetName="Card"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="GamesList"
                 ItemTemplate="{StaticResource GameTileTemplate}"
                 ItemContainerStyle="{StaticResource GameTileItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 KeyDown="GamesList_KeyDown"
                 PreviewMouseLeftButtonUp="GamesList_PreviewMouseLeftButtonUp"
                 SelectionChanged="GamesList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />
            </ListBox.Resources>
        </ListBox>

        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/Images/no_rom_hero.png"
                   MaxHeight="300" Stretch="Uniform" />
            <TextBlock Text="Noch keine Spiele gefunden" HorizontalAlignment="Center" Margin="0,18,0,0"
                       FontFamily="{DynamicResource FontIisu}" FontSize="34"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Füge einen Ordner hinzu – MiiSO erkennt .exe, .lnk und .url"
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       FontFamily="{DynamicResource FontConsoleSans}" FontSize="18"
                       Foreground="{DynamicResource TextBrushDark}" />
            <Button x:Name="AddFolderButton" Content="Spiele-Ordner hinzufügen …"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Width="380" Height="68" HorizontalAlignment="Center" Margin="0,24,0,0"
                    Click="AddFolder_Clicked" />
        </StackPanel>
    </Grid>
</UserControl>