<UserControl x:Class="MiiSO.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MiiSO.Services">

    <UserControl.Resources>
        <svc:GameCoverConverter x:Key="CoverConv" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero-Hintergrund -->
        <Grid Grid.Row="0">
            <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.4">
                <Image.Effect>
                    <BlurEffect Radius="26" />
                </Image.Effect>
            </Image>
            <Border Background="{DynamicResource GameDetailsOverlayBrush}" />
        </Grid>

        <!-- Inhalt -->
        <Grid Grid.Row="0" Margin="76,26,76,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CoverFrame" Width="434" Height="250" CornerRadius="16"
                    Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="#88224F96" BorderThickness="1" ClipToBounds="True"
                    VerticalAlignment="Center">
                <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="54,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontFamily="{DynamicResource FontIisu}" FontSize="50"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="PC" FontFamily="{DynamicResource FontGameMaster}" FontSize="24"
                               Foreground="{DynamicResource GlyphBrush}" />
                    <TextBlock x:Name="MetaText" Margin="22,2,0,0"
                               FontFamily="{DynamicResource FontConsoleSans}" FontSize="17"
                               Foreground="{DynamicResource TextBrushDark}"
                               Text="0x gestartet" />
                </StackPanel>
                <ScrollViewer Height="260" Margin="0,24,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <TextBlock x:Name="DescText" FontFamily="{DynamicResource FontConsoleSans}" FontSize="19"
                               LineHeight="28" Foreground="{DynamicResource TextBrushDark}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- Aktionen -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
            <Button x:Name="PlayButton" Style="{DynamicResource PrimaryButtonStyle}"
                    Content="Starten" Width="280" Height="74" Click="Play_Clicked" />
            <Button x:Name="FolderButton" Style="{DynamicResource SecondaryButtonStyle}"
                    Content="Ordner öffnen" Width="230" Height="74" Margin="20,0,0,0"
                    Click="Folder_Clicked" />
            <Button x:Name="BackButton" Style="{DynamicResource SecondaryButtonStyle}"
                    Content="Zurück" Width="190" Height="74" Margin="20,0,0,0"
                    Click="Back_Clicked" />
        </StackPanel>
    </Grid>
</UserControl>